rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /traffic_police/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.email == 'admin@nashikcity.gov.in' || request.auth.token.email == resource.data.email);
    }
    match /admin_profiles/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@nashikcity.gov.in';
    }
  }
}
