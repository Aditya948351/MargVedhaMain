rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- ADMIN COLLECTIONS (Backend & Web Dashboard) ---
    match /traffic_police/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.email == 'admin@nashikcity.gov.in' || request.auth.token.email == resource.data.email);
    }
    match /admin_profiles/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@nashikcity.gov.in';
    }

    // --- TRAFFIC DATA (YOLOv11 Backend writes, App & Dashboard reads) ---
    match /traffic_data/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /junction_counts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /junction_status/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /junctions/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- ENFORCEMENT (Fines, Violations) ---
    match /fines/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /violations/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /anpr_detections/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- CITIZEN APP ---
    match /citizen_users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /citizen_users/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /rewards/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /alerts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /bus_routes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /route_suggestions/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- SIMULATION ENGINE COLLECTIONS ---
    match /incidents/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /violations/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /citizen_reports/{document=**} {
      allow read: if true;
      allow write: if true;  // Citizens can write without auth
    }

    // --- GLOBAL SETTINGS ---
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
